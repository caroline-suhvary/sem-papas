# Copie este arquivo para ".env.local" e cole os valores do seu app Web do Firebase
# (Console do Firebase > Configurações do projeto > Seus apps > Configuração do SDK).
# Esses valores NÃO são senhas: o Firebase foi feito para expô-los no navegador.
# Quem protege os dados são as regras (firestore.rules e storage.rules).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
